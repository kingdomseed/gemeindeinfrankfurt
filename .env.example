# Copy to .env.local and fill in. Never commit real keys.

# Supabase project (EU / Frankfurt region). Local: values printed by `npx supabase start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used by the public registration flow after the edit token is checked.
SUPABASE_SERVICE_ROLE_KEY=

# Payload CMS (admin at /admin). Its tables live in the "payload" schema of the
# same Postgres. Local: the database URL printed by `npx supabase start`.
DATABASE_URI=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Long random string that signs Payload admin sessions, e.g. `openssl rand -hex 32`.
PAYLOAD_SECRET=

# Public URL of this site, used in the edit links sent by email.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend. Without RESEND_API_KEY, emails are logged and skipped (local development).
RESEND_API_KEY=
EMAIL_FROM="Video Training <training@example.org>"
EMAIL_REPLY_TO=

# Contact people shown in the footer and on the privacy page, separated by ";".
CONTACTS="Jason Holt <kingdomseed@gmail.com>; Max <golotamax@gmail.com>"
