# Copy to .env.local and fill in. Never commit real keys.

# Supabase project (EU / Frankfurt region), from the dashboard's Connect panel.
# Use a development project locally, not production.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used by the public registration flow after the edit token is checked.
SUPABASE_SERVICE_ROLE_KEY=

# Payload CMS (admin at /admin). Its tables live in the "payload" schema of the
# same Postgres: the project's database connection string.
DATABASE_URI=
# Long random string that signs Payload admin sessions, e.g. `openssl rand -hex 32`.
PAYLOAD_SECRET=

# Public URL of this site, used in the edit links sent by email.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend. Without RESEND_API_KEY, emails are logged and skipped (local development).
RESEND_API_KEY=
EMAIL_FROM="Video Training <training@example.org>"
EMAIL_REPLY_TO=

# Contact people shown in the footer and on the privacy page, separated by ";".
CONTACTS="Jason Holt <kingdomseed@gmail.com>; Max Franz <golotamax@gmail.com>"
# The imprint's representative and person responsible for the content, as
# "Name" or "Name <email>". Without an email the imprint shows the CMS contact
# email; unset, it names nobody.
IMPRINT=
