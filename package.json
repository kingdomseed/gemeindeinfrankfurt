{
  "name": "video-training-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm test && npm run doctor",
    "db:reset": "supabase db reset",
    "seed:cms": "payload run src/cms/seed/index.ts",
    "cms:importmap": "payload generate:importmap && oxlint --fix \"src/app/(payload)/admin/importMap.ts\" && oxfmt \"src/app/(payload)/admin/importMap.ts\"",
    "db:types": "supabase gen types typescript --local > src/lib/supabase/database.types.ts && oxfmt src/lib/supabase/database.types.ts",
    "prepare": "lefthook install || true",
    "doctor": "react-doctor --no-telemetry --yes --blocking warning ."
  },
  "dependencies": {
    "@chakra-ui/react": "^3.37.0",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@payloadcms/db-postgres": "3.93.0",
    "@payloadcms/next": "3.93.0",
    "@payloadcms/richtext-lexical": "3.93.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "graphql": "^16.15.0",
    "next": "16.4.4",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "payload": "3.93.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.37.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "react-doctor": "^0.9.22",
    "supabase": "^3.0.0",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "dompurify": "^3.4.17",
    "happy-dom": "^21.0.4"
  },
  "engines": {
    "node": "^22.23.4 || >=24.22.1"
  },
  "reactDoctor": {
    "ignore": {
      "files": [
        "archive/**"
      ]
    }
  }
}
