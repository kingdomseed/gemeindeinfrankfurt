{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "nextjs",
    "jsx-a11y",
    "import",
    "promise",
    "vitest"
  ],
  "options": {
    "typeAware": true
  },
  "env": {
    "builtin": true,
    "browser": true,
    "node": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "ignorePatterns": [
    ".next/**",
    "out/**",
    "build/**",
    "coverage/**",
    "next-env.d.ts",
    ".agents/**",
    ".claude/skills/**"
  ],
  "rules": {
    "eqeqeq": [
      "error",
      "always",
      {
        "null": "ignore"
      }
    ],
    "no-console": [
      "error",
      {
        "allow": ["warn", "error"]
      }
    ],
    "no-eval": "error",
    "no-implied-eval": "error",
    "no-new-func": "error",
    "no-param-reassign": "error",
    "no-var": "error",
    "prefer-const": "error",
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ],
    "no-unused-expressions": "error",
    "no-array-constructor": "error",
    "default-case-last": "error",
    "no-else-return": "error",
    "no-lonely-if": "error",
    "no-nested-ternary": "error",
    "curly": ["error", "multi-line"],
    "typescript/ban-ts-comment": [
      "error",
      {
        "ts-expect-error": "allow-with-description",
        "minimumDescriptionLength": 10
      }
    ],
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/consistent-type-definitions": ["error", "type"],
    "typescript/no-empty-object-type": "error",
    "typescript/no-require-imports": "error",
    "typescript/no-namespace": "error",
    "typescript/prefer-as-const": "error",
    "typescript/no-unsafe-function-type": "error",
    "typescript/no-wrapper-object-types": "error",
    "typescript/triple-slash-reference": "error",
    "typescript/await-thenable": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/require-await": "error",
    "typescript/return-await": ["error", "in-try-catch"],
    "typescript/only-throw-error": "error",
    "typescript/prefer-promise-reject-errors": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-unnecessary-condition": "error",
    "typescript/restrict-template-expressions": [
      "error",
      {
        "allowNumber": true
      }
    ],
    "typescript/restrict-plus-operands": "error",
    "typescript/no-base-to-string": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/prefer-nullish-coalescing": [
      "error",
      {
        "ignorePrimitives": {
          "string": true
        }
      }
    ],
    "typescript/prefer-optional-chain": "error",
    "typescript/no-deprecated": [
      "error",
      {
        "allow": [
          {
            "from": "package",
            "package": "next-intl",
            "name": ["setRequestLocale"]
          },
          {
            "from": "package",
            "package": "next-intl/server",
            "name": ["setRequestLocale"]
          }
        ]
      }
    ],
    "import/no-cycle": "error",
    "import/no-unassigned-import": [
      "error",
      {
        "allow": ["server-only", "**/*.css"]
      }
    ],
    "import/no-duplicates": "error",
    "import/no-self-import": "error",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/jsx-key": "error",
    "react/jsx-no-duplicate-props": "error",
    "react/jsx-no-target-blank": "error",
    "react/no-danger": "error",
    "react/no-unescaped-entities": "error",
    "react/react-in-jsx-scope": "off",
    "react/static-components": "error",
    "react/use-memo": "error",
    "react/preserve-manual-memoization": "error",
    "react/incompatible-library": "error",
    "react/immutability": "error",
    "react/globals": "error",
    "react/refs": "error",
    "react/set-state-in-effect": "error",
    "react/set-state-in-render": "error",
    "react/error-boundaries": "error",
    "react/purity": "error",
    "react/unsupported-syntax": "error",
    "nextjs/no-html-link-for-pages": "error",
    "nextjs/no-img-element": "error",
    "nextjs/no-async-client-component": "error",
    "nextjs/no-sync-scripts": "error",
    "nextjs/no-head-element": "error",
    "nextjs/no-typos": "error",
    "nextjs/inline-script-id": "error",
    "nextjs/no-assign-module-variable": "error",
    "jsx-a11y/alt-text": "error",
    "jsx-a11y/aria-props": "error",
    "jsx-a11y/aria-proptypes": "error",
    "jsx-a11y/aria-unsupported-elements": "error",
    "jsx-a11y/role-has-required-aria-props": "error",
    "jsx-a11y/role-supports-aria-props": "error",
    "jsx-a11y/label-has-associated-control": "error",
    "jsx-a11y/no-autofocus": "error",
    "jsx-a11y/click-events-have-key-events": "error",
    "jsx-a11y/no-static-element-interactions": "error",
    "unicorn/no-null": "off",
    "unicorn/prefer-node-protocol": "error",
    "unicorn/throw-new-error": "error",
    "unicorn/no-useless-spread": "error",
    "promise/no-return-wrap": "error",
    "promise/param-names": "error"
  },
  "overrides": [
    {
      "files": ["**/*.d.ts"],
      "rules": {
        "typescript/consistent-type-definitions": "off"
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "typescript/no-non-null-assertion": "off",
        "typescript/no-unsafe-member-access": "off"
      }
    },
    {
      "files": ["src/lib/domain/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "react",
                "message": "src/lib/domain is pure business rules: no React, Next.js or i18n. Pass data in as arguments."
              },
              {
                "name": "react-dom",
                "message": "src/lib/domain is pure business rules: no React, Next.js or i18n. Pass data in as arguments."
              },
              {
                "name": "next",
                "message": "src/lib/domain is pure business rules: no React, Next.js or i18n. Pass data in as arguments."
              },
              {
                "name": "next-intl",
                "message": "src/lib/domain is pure business rules: no React, Next.js or i18n. Pass data in as arguments."
              }
            ],
            "patterns": [
              {
                "group": ["next/*", "next-intl/*", "@supabase/*"],
                "message": "src/lib/domain is pure business rules: no framework or database imports."
              },
              {
                "group": [
                  "@/app/**",
                  "@/features/**",
                  "@/components/**",
                  "@/theme/**",
                  "@/i18n/**",
                  "@/lib/*",
                  "@/lib/*/**",
                  "!@/lib/domain/**"
                ],
                "message": "src/lib/domain imports nothing from other layers. Other layers import from it."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/theme/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/app/**", "@/features/**", "@/components/**", "@/lib/**", "@/i18n/**"],
                "message": "src/theme holds Chakra tokens and recipes only; it imports nothing from the app."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/components/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/app/**", "@/features/**"],
                "message": "Shared components sit below features and routes. Pass server actions and data in as props."
              },
              {
                "group": [
                  "@/lib/supabase/**",
                  "@/lib/auth",
                  "@/lib/data",
                  "@/lib/registrations",
                  "@/lib/email/**"
                ],
                "allowTypeImports": true,
                "message": "Components never touch data access. Load data in the route or server action and pass it in as props."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/components/ui/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "next-intl",
                "message": "src/components/ui is generic: take translated text as props instead of calling next-intl."
              }
            ],
            "patterns": [
              {
                "group": ["@/app/**", "@/features/**", "@/i18n/**", "@/lib/**"],
                "message": "src/components/ui is generic Chakra building blocks: no app, feature, i18n or domain imports. Take everything as props."
              },
              {
                "group": ["next-intl/*", "@supabase/*"],
                "message": "src/components/ui is generic: no i18n or data access."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/features/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/app/**"],
                "message": "Features never import from routes. The route passes server actions in as props."
              },
              {
                "group": [
                  "@/lib/supabase/**",
                  "!@/lib/supabase/browser",
                  "@/lib/auth",
                  "@/lib/data",
                  "@/lib/registrations",
                  "@/lib/email/**"
                ],
                "allowTypeImports": true,
                "message": "Features never touch server data access. The route or server action loads data and passes it in. Only @/lib/supabase/browser (login, realtime) is allowed."
              },
              {
                "group": ["@supabase/*"],
                "allowTypeImports": true,
                "message": "Features never talk to Supabase directly."
              }
            ]
          }
        ]
      }
    }
  ]
}
